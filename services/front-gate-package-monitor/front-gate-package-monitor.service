[Unit]
Description=Front gate package presence monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guosq
Group=guosq
EnvironmentFile=/home/guosq/.config/front-gate-package-monitor.env
ExecStart=/usr/bin/python3 /home/guosq/workspace/stanley-rasp2/services/front-gate-package-monitor/monitor.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/guosq/workspace/stanley-rasp2
ReadWritePaths=/home/guosq/services/front-gate-package-monitor/data

[Install]
WantedBy=multi-user.target
